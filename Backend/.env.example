PORT=8080
MONGODB_URI=mongodb://mongo:27017
MONGODB_DATABASE=cambodia_shop
JWT_SECRET=REPLACE_WITH_64_HEX_OR_RANDOM_BYTES_MINIMUM_32_CHARS
JWT_ISSUER=ecommerce-api
# First registered user is NOT automatically admin. Promote through a controlled DB operation.
# Docker Compose MongoDB credentials (not needed when using MongoDB Atlas).
MONGO_ROOT_USERNAME=shoproot
MONGO_ROOT_PASSWORD=REPLACE_WITH_A_STRONG_RANDOM_PASSWORD
SHOP_DB_USERNAME=shopapp
SHOP_DB_PASSWORD=REPLACE_WITH_A_DIFFERENT_STRONG_RANDOM_PASSWORD
# PayWay merchant ID and HMAC signing key must be provided by ABA for your merchant account.
# Do not use an RSA key or a public key as the HMAC signing key.
# Older onboarding docs sometimes call this ABA_PAYWAY_API_KEY; that value is accepted as a compatibility alias.
ABA_PAYWAY_MERCHANT_ID=
ABA_PAYWAY_HMAC_KEY=
ABA_PAYWAY_API_KEY=
ABA_PAYWAY_BASE_URL=https://checkout-sandbox.payway.com.kh
ABA_PAYWAY_PURCHASE_URL=https://checkout-sandbox.payway.com.kh/api/payment-gateway/v1/payments/purchase
ABA_PAYWAY_CHECK_TRANSACTION_URL=https://checkout-sandbox.payway.com.kh/api/payment-gateway/v1/payments/check-transaction-2
PUBLIC_API_BASE_URL=http://localhost:8080
FRONTEND_SUCCESS_URL=http://localhost:3000/payment/success
FRONTEND_CANCEL_URL=http://localhost:3000/payment/cancel
CORS_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1
